  "narrative": {
    "northStar": "The Application Workshop",
    "overview": "A student opens Intern-Bot to finish an application. At a glance they should be able to tell which job they are looking at, what the form actually contains, and whose turn it is. Four miniature workbenches make the preparation stages recognizable. The employer's question and the next available action sit alongside them in a native inspector.\n\nThe workshop is a model railway–scale object on a paper-colored desk. The surrounding app uses ink type, restrained borders and a deep green decision panel. The same four machines reappear in small nameplates on related screens. Interaction, evidence and approval live in Qt. The illustration can disappear and the workflow still works.",
    "keyCharacteristics": [
      "A named station, a physical tool and a distinct silhouette for each step.",
      "One selected application, one active run at a time, one primary action in its inspector.",
      "An observable field value, question or receipt behind every claim about progress."
    ],
    "rules": [
      {
        "name": "The Station Paint Rule",
        "body": "Use a station's paint to identify the machine across states. Intake uses ochre, Fill uses blue, Verify uses sage and Dispatch uses orange. Reserve those paints for the models. A blue Fill worker can stand still during a warning and an orange Dispatch worker can wait for approval.",
        "section": "colors"
      },
      {
        "name": "The Workbench Shadow Rule",
        "body": "Keep cast shadows in the miniature. Use surface tone and a single-pixel border to separate native layers. A selected paper row takes a sage fill. An active navigation item and the inspector take a deep green fill. Keep the UI edges clean so the miniature's cast shadows remain legible.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do bind every station, field count, question and receipt to the same run ID as the inspector.",
      "Do retain the exact question, the reviewed value and who confirmed a submission in native text.",
      "Do keep the decision and its action visible at compact width and with worker motion disabled.",
      "Do name the recipient, the data and the scope before a user sends context or approves an answer."
    ],
    "donts": [
      "Don't advance a station on a timer, move the folder or a lamp without an engine checkpoint, or use the demo timeline as engine state.",
      "Don't represent an optional omission as a verified value, a send attempt as a receipt or a manual attestation as machine evidence.",
      "Don't put personal form contents or a submit action in the scene bridge."
    ]
  }
}
