/* Template: each $$name is a token from gui/theme.py (LIGHT / DARK). Type scale 11 / 13 / 15 / 20. Spacing 4 / 8 / 12 / 16 / 24. */

QWidget {
    color: $text;
    font-size: 13px;
}

QMainWindow,
QDialog,
QWidget#appShell {
    background: $bg;
}

QLabel {
    background: transparent;
}

QLabel[role="pageTitle"] { font-family: "Futura"; font-size: 30px; font-weight: 500; }
QLabel[role="section"] { font-size: 18px; font-weight: 650; }
QLabel[role="question"] { font-size: 15px; font-weight: 600; }
QLabel[role="inspectorTitle"] { font-family: "Futura"; font-size: 25px; font-weight: 500; }
QLabel[role="muted"] { color: $text2; }
QLabel[role="caption"] { color: $text3; font-size: 11px; }
QLabel[role="overline"] { color: $text3; font-size: 11px; font-weight: 600; }
QLabel[role="fact"] { color: $text2; padding: 2px 0; }

QLabel[tone="success"] { color: $success; }
QLabel[tone="warning"] { color: $warning; }
QLabel[tone="danger"] { color: $danger; }
QLabel[tone="info"] { color: $info; }

/* Shell */

QFrame#navigation { background: $panel; border: none; }
QFrame#navigation QLabel { color: $panel_text; }
QLabel#brand { color: $panel_text; font-family: "Futura"; font-size: 21px; font-weight: 700; }

QPushButton#navButton {
    background: transparent;
    border: 2px solid transparent;
    border-radius: 8px;
    color: $panel_muted;
    font-weight: 500;
    padding: 5px 10px;
}

QPushButton#navButton:hover { background: $panel_inset; color: $panel_text; }
QPushButton#navButton:checked { background: $panel_line; color: $panel_text; font-weight: 600; }
QPushButton#navButton:focus { border-color: $panel_button; }

QLabel#navBadge {
    background: $panel_button;
    border-radius: 10px;
    color: $on_accent;
    font-size: 11px;
    font-weight: 700;
    min-height: 20px;
    max-height: 20px;
    min-width: 20px;
    padding: 0 6px;
}

QFrame#card {
    background: $surface;
    border: 1px solid $border;
    border-radius: 10px;
}

/* Feedback */

QLabel#messageBar,
QLabel#callout {
    background: $surface;
    border: 1px solid $border;
    border-left: 1px solid $info;
    border-radius: 6px;
    color: $text;
    padding: 8px 12px;
}

QLabel#messageBar[tone="success"] { border-left-color: $success; }
QLabel#messageBar[tone="warning"], QLabel#callout { border-left-color: $warning; }
QLabel#messageBar[tone="danger"] { border-left-color: $danger; }

/* Inputs */

QLineEdit,
QComboBox,
QPlainTextEdit {
    background: $surface;
    border: 1px solid $border;
    border-radius: 6px;
    color: $text;
    padding: 5px 8px;
    selection-background-color: $selection;
    selection-color: $text;
}

QLineEdit:focus,
QComboBox:focus,
QPlainTextEdit:focus {
    border-color: $focus;
}

QLineEdit:disabled,
QComboBox:disabled,
QPlainTextEdit:disabled {
    background: $surface2;
    color: $text3;
}

QComboBox::drop-down {
    background: transparent;
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    height: 6px;
    image: url("$chevron");
    width: 10px;
}

QComboBox QAbstractItemView {
    background: $surface;
    border: 1px solid $border;
    selection-background-color: $selection;
    selection-color: $text;
}

/* Buttons: secondary by default; variant = primary | ghost | danger | chip */

QPushButton {
    background: $surface;
    border: 1px solid $border;
    border-radius: 6px;
    color: $text;
    font-weight: 500;
    padding: 5px 12px;
}

QWidget#bulkBar QPushButton { padding: 5px 6px; }

QPushButton:hover { background: $surface2; }
QPushButton:pressed { background: $border; }
QPushButton:focus { border-color: $focus; }
QPushButton:disabled { background: $surface2; border-color: $surface2; color: $text3; }

QPushButton[variant="primary"] {
    background: $accent;
    border-color: $accent;
    color: $on_accent;
    font-weight: 600;
}

QPushButton[variant="primary"]:hover { background: $accent_hover; border-color: $accent_hover; }
QPushButton[variant="primary"]:focus { border-color: $text; }
QPushButton[variant="primary"]:disabled { background: $surface2; border-color: $border; color: $text3; }

QPushButton[variant="ghost"],
QPushButton[variant="danger"] {
    background: transparent;
    border-color: transparent;
    color: $text2;
}

QPushButton[variant="danger"] { color: $danger; }
QPushButton[variant="ghost"]:hover,
QPushButton[variant="danger"]:hover { background: $surface2; }
QPushButton[variant="ghost"]:hover { color: $text; }
QPushButton[variant="ghost"]:focus,
QPushButton[variant="danger"]:focus { border-color: $focus; }
QPushButton[variant="ghost"]:disabled,
QPushButton[variant="danger"]:disabled,
QPushButton[variant="chip"]:disabled { background: transparent; color: $text3; }

QPushButton[variant="chip"] {
    background: transparent;
    border-radius: 10px;
    color: $text2;
    font-size: 12px;
    padding: 3px 8px;
}

QPushButton[variant="chip"]:checked {
    background: $selection;
    border-color: $focus;
    color: $text;
    font-weight: 600;
}

QToolButton {
    background: transparent;
    border: 1px solid $border;
    border-radius: 6px;
    font-size: 15px;
    padding: 2px 9px;
}

QToolButton:hover { background: $surface2; }
QToolButton:focus { border-color: $focus; }
QToolButton::menu-indicator { image: none; width: 0; }

QCheckBox { spacing: 8px; background: transparent; }

/* Lists, tables, trees */

QTableWidget,
QTreeWidget,
QListWidget {
    alternate-background-color: $surface2;
    background: $surface;
    border: 1px solid $border;
    border-radius: 10px;
    gridline-color: transparent;
    outline: none;
    selection-background-color: $selection;
    selection-color: $text;
}

QTableWidget::item { border-bottom: 1px solid $surface2; padding: 0 8px; }
QTreeWidget::item { padding: 3px 0; }

QTableWidget::item:selected,
QTreeWidget::item:selected,
QListWidget::item:selected {
    background: $selection;
    color: $text;
}

QHeaderView::section {
    background: $surface;
    border: none;
    border-bottom: 1px solid $border;
    color: $text3;
    font-size: 11px;
    font-weight: 600;
    padding: 6px 8px;
}

QTableCornerButton::section { background: $surface; border: none; }

QListWidget#sectionNav {
    background: transparent;
    border: none;
}

QListWidget#sectionNav::item {
    border-radius: 6px;
    color: $text2;
    padding: 6px 10px;
}

QListWidget#sectionNav::item:hover { background: $surface2; }
QListWidget#sectionNav::item:selected { background: $selection; color: $text; }

QTabWidget::pane {
    background: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: $text2;
    padding: 6px 14px;
}

QTabBar::tab:selected { border-bottom-color: $focus; color: $text; }
QTabBar::tab:hover { color: $text; }

QScrollArea,
QScrollArea > QWidget#qt_scrollarea_viewport,
QScrollArea > QWidget > QWidget#scrollContent {
    background: transparent;
    border: none;
}

QProgressBar {
    background: $surface2;
    border: none;
    border-radius: 3px;
    max-height: 6px;
}

QProgressBar::chunk { background: $accent; border-radius: 3px; }

QSplitter::handle { background: transparent; }

QMenu {
    background: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item { border-radius: 4px; padding: 5px 18px; }
QMenu::item:selected { background: $selection; color: $text; }
QMenu::item:disabled { color: $text3; }
QMenu::separator { background: $border; height: 1px; margin: 4px 6px; }

QToolTip {
    background: $surface2;
    border: 1px solid $border;
    color: $text;
    padding: 4px 6px;
}

/* Application workshop */

/* Orbit / Bar field / List: one joined control, the checked view inset in navy. */
QFrame#segments { background: $surface2; border: 1px solid $border; border-radius: 8px; }
QPushButton[variant="segment"] { background: transparent; border: 2px solid transparent; border-radius: 6px; color: $text2; padding: 3px 10px; }
QPushButton[variant="segment"]:hover { background: $selection; color: $text; }
QPushButton[variant="segment"]:checked { background: $panel; color: $panel_text; font-weight: 600; }
QPushButton[variant="segment"]:focus { border-color: $focus; }

/* The caption closes the scene: same width, rounded bottom to match the scene's rounded top. */
QFrame#sceneCaptionBar { background: $sky; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; }
QLabel[role="sceneCaption"] { background: transparent; color: $panel_muted; font-size: 12px; padding: 7px 14px; }
QFrame#setupPanel, QFrame#inspector { background: $panel; border: none; border-radius: 14px; }
QFrame#setupPanel QLabel, QFrame#inspector QLabel { color: $panel_text; }
QFrame#setupPanel QLabel[role="muted"], QFrame#inspector QLabel[role="muted"], QFrame#inspector QLabel[role="caption"] { color: $panel_muted; }
QFrame#inspector QLabel#callout { background: $panel_inset; border: 1px solid $panel_line; color: $panel_text; font-size: 15px; font-weight: 600; }
QFrame#inspector QPushButton[variant="primary"] { background: $panel_button; border-color: $panel_button; color: $on_accent; }
QFrame#inspector QPushButton[variant="primary"]:focus { border: 2px solid $panel_text; }
QFrame#inspector QPushButton[variant="ghost"], QFrame#setupPanel QPushButton, QFrame#inspector QToolButton { background: $panel_inset; border-color: $panel_line; color: $panel_text; }
QFrame#inspector QPushButton[variant="danger"] { color: #ffa8b0; }
QFrame#inspector QPushButton[variant="danger"]:hover, QFrame#inspector QPushButton[variant="ghost"]:hover { background: $panel_line; }
QFrame#inspector QToolButton:hover { background: $panel_line; }
QFrame#inspector QToolButton#disclosure { background: transparent; border: 1px solid transparent; color: $panel_muted; font-size: 13px; font-weight: 600; padding: 3px 4px 3px 0; }
QFrame#inspector QToolButton#disclosure:hover, QFrame#inspector QToolButton#disclosure:checked { color: $panel_text; }
QFrame#inspector QToolButton#disclosure:focus { border-color: $panel_text; }
QFrame#inspector QPushButton:disabled { background: $panel_inset; border-color: $panel_line; color: $panel_muted; }
QFrame#inspector QProgressBar { background: $panel_line; }
QFrame#inspector QProgressBar::chunk { background: $panel_text; }
QListWidget#sectionNav { background: $surface2; border-radius: 8px; padding: 6px; }
QListWidget#sectionNav::item:selected { background: $panel; color: $panel_text; }
QTextBrowser { background: $surface; color: $text; border: 1px solid $border; border-radius: 8px; padding: 12px; }
