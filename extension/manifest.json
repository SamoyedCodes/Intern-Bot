{
  "manifest_version": 3,
  "name": "Intern-Bot Local Autofill",
  "version": "2.28.0",
  "description": "Local desktop-controlled application adapters. No account or cloud service.",
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://*/*"],
    "js": ["generated/scan.js", "generated/adapters.js", "runtime.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"}
}
